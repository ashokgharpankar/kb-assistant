# Rendered by the nginx entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Liveness for Docker, Kubernetes and the load balancer. Doesn't touch the API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime settings for the UI (see loadRuntimeEnv in src/lib/auth.ts).
    # None of these are secrets: the browser sees them anyway.
    location = /config.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '{"VITE_COGNITO_AUTHORITY":"${VITE_COGNITO_AUTHORITY}","VITE_COGNITO_CLIENT_ID":"${VITE_COGNITO_CLIENT_ID}","VITE_COGNITO_DOMAIN":"${VITE_COGNITO_DOMAIN}"}';
    }

    # Same-origin API: /api/ask → ${API_UPSTREAM}/ask. The trailing slash strips /api.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Server-sent events: pass each token on as it arrives, don't buffer the answer.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        client_max_body_size 16k;
    }

    # Vite puts a content hash in every asset file name, so they can be cached forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page app: unknown paths get index.html, which must never be cached.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
