# Copy to .env (which is git-ignored). Every key maps to kb_core/settings.py.

KB_ENV=local

# "ollama" = free local models. "bedrock" = paid AWS models.
KB_LLM_PROVIDER=ollama

KB_AWS_REGION=us-east-1
KB_BEDROCK_CHAT_MODEL=amazon.nova-micro-v1:0
KB_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
KB_EMBED_DIMENSIONS=512
# After `make tf-apply`:  terraform -chdir=infra/terraform/envs/dev output -raw app_role_arn
KB_APP_ROLE_ARN=

# Phase 1: ingestion and retrieval (defaults shown)
KB_DATA_DIR=data/raw
KB_CHUNK_SIZE=1200
KB_CHUNK_OVERLAP=200
KB_RETRIEVAL_K=4
KB_MIN_SIMILARITY=0.4

# Phase 2c: sign-in. "cognito" (default) rejects requests without a valid token.
# "disabled" is for local tests only. Fill the IDs from `make cognito-env`.
KB_AUTH_MODE=cognito
KB_COGNITO_USER_POOL_ID=
KB_COGNITO_CLIENT_ID=

KB_DATABASE_URL=postgresql+psycopg://kb:kb_local_only@localhost:5433/kb

# From the Langfuse UI (http://localhost:3000) after you create a project
KB_LANGFUSE_HOST=http://localhost:3000
KB_LANGFUSE_PUBLIC_KEY=
KB_LANGFUSE_SECRET_KEY=
