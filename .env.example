# Copy to .env (which is git-ignored). Every key maps to kb_core/settings.py,
# where the defaults live. A line here only matters if it differs from the default:
# you can delete any line whose value you don't want to change.

KB_ENV=local

# "ollama" = free local models. "bedrock" = paid AWS models.
KB_LLM_PROVIDER=ollama
KB_OLLAMA_CHAT_MODEL=llama3.2
KB_OLLAMA_EMBED_MODEL=nomic-embed-text

KB_AWS_REGION=us-east-1
KB_BEDROCK_CHAT_MODEL=amazon.nova-micro-v1:0
KB_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
KB_EMBED_DIMENSIONS=512
# After `make tf-apply`:  terraform -chdir=infra/terraform/envs/dev output -raw app_role_arn
KB_APP_ROLE_ARN=

# Ingestion and retrieval (defaults shown)
KB_DATA_DIR=data/raw
KB_CHUNK_SIZE=1200
KB_CHUNK_OVERLAP=200
KB_RETRIEVAL_K=4
# Phase 4: sections from the PDF's table of contents down to this depth, each chunk
# embedded under its heading path, and hybrid search (vectors + keywords).
KB_TOC_DEPTH=4
KB_CHUNK_HEADERS=true
KB_RETRIEVAL_MODE=hybrid
# "flashrank" turns on a small local reranker (downloads ~30 MB once).
KB_RERANKER=none
KB_RETRIEVAL_CANDIDATES=20
# Measured for nomic-embed-text; re-check with `make eval` after changing models.
KB_MIN_SIMILARITY=0.62
KB_ANSWER_MAX_TOKENS=600
# Phase 5b: "agent" searches again when an answer comes back "not found" (max 3 searches).
KB_ANSWER_MODE=pipeline
KB_AGENT_MAX_SEARCHES=3

# Phase 2c: sign-in. "cognito" (default) rejects requests without a valid token.
# "disabled" is for local tests only. Fill the IDs from `make cognito-env`.
KB_AUTH_MODE=cognito
KB_COGNITO_USER_POOL_ID=
KB_COGNITO_CLIENT_ID=

KB_DATABASE_URL=postgresql+psycopg://kb:kb_local_only@localhost:5433/kb

# Tracing (Phase 2a). Off while the keys are empty. `make langfuse-up`, then create a
# project at http://localhost:3000 and copy its API keys here.
KB_LANGFUSE_HOST=http://localhost:3000
KB_LANGFUSE_PUBLIC_KEY=
KB_LANGFUSE_SECRET_KEY=
